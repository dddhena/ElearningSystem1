@model IEnumerable<ElearningSystem.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Available Courses</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
    {
        <a asp-action="Create" class="btn btn-success">Create New Course</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No courses available at the moment.
    </div>
}
else
{
    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text text-muted small">Created on @course.CreatedAt.ToString("MMM dd, yyyy")</p>
                        <p class="card-text">
                            @(course.Description?.Length > 100 ? course.Description.Substring(0, 100) + "..." : course.Description)
                        </p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-outline-primary w-100">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
