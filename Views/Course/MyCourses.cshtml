@model IEnumerable<ElearningSystem.Models.Course>

@{
    ViewData["Title"] = "My Enrolled Courses";
}

<div class="mb-4">
    <h2>My Enrolled Courses</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You are not enrolled in any courses yet. <a asp-action="Index">Browse available courses</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-primary">
                    <div class="card-body">
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text">
                            @(course.Description?.Length > 100 ? course.Description.Substring(0, 100) + "..." : course.Description)
                        </p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-primary w-100">Continue Learning</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
