@{
    ViewData["Title"] = "Real-Time Interaction";
}

<div class="container py-4">
    <div class="page-hero shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="text-gradient">Live Classroom Chat</h1>
                <p class="text-muted-custom mb-0">Engage with instructors and students in real-time.</p>
            </div>
            <div id="connection-status" class="badge rounded-pill bg-secondary px-3 py-2 shadow-sm">
                <i class="bi bi-circle-fill me-2 small"></i><span id="status-text">Connecting...</span>
            </div>
        </div>
    </div>

    <div class="chat-container shadow-lg">
        <div class="chat-header">
            <div class="live-dot"></div>
            <h5 class="mb-0 fw-bold text-white">General Discussion</h5>
        </div>
        
        <div class="chat-messages p-4" id="chat-messages">
            <div class="system-msg mt-5">
                <i class="bi bi-shield-lock me-1"></i> Messages are encrypted and stored securely.
            </div>
            <div class="text-center text-muted-custom mt-4" id="empty-state">
                <div class="display-4 opacity-25 mb-3">
                    <i class="bi bi-chat-quote"></i>
                </div>
                <p>No messages in this session yet.</p>
            </div>
        </div>

        <div class="chat-input-area">
            <input type="text" id="message-input" class="form-control" placeholder="Type your message..." disabled>
            <button class="chat-send-btn shadow-sm" id="send-button" disabled>
                <i class="bi bi-send-fill me-2"></i>Send
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub")
            .withAutomaticReconnect()
            .build();

        const messageInput = document.getElementById("message-input");
        const sendButton = document.getElementById("send-button");
        const chatMessages = document.getElementById("chat-messages");
        const statusBadge = document.getElementById("connection-status");
        const statusText = document.getElementById("status-text");
        const emptyState = document.getElementById("empty-state");
        
        const currentUserName = "@(User.Identity?.Name ?? "Guest")";

        connection.on("ReceiveMessage", function (user, message, time) {
            if (emptyState && emptyState.parentNode) emptyState.remove();

            const isMine = user === currentUserName;
            const bubbleClass = isMine ? "mine" : "theirs";
            
            const msgBubble = document.createElement("div");
            msgBubble.className = `msg-bubble ${bubbleClass}`;
            msgBubble.innerHTML = `
                <div class="msg-meta">${user} • ${time}</div>
                <div class="msg-text shadow-sm">${message}</div>
            `;
            
            chatMessages.appendChild(msgBubble);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        });

        connection.start().then(function () {
            statusText.textContent = "Online";
            statusBadge.classList.replace("bg-secondary", "bg-success");
            const icon = statusBadge.querySelector('i');
            if (icon) icon.classList.add('text-white');
            
            connection.invoke("JoinCourseGroup", "general");
            
            sendButton.disabled = false;
            messageInput.disabled = false;
        }).catch(function (err) {
            statusText.textContent = "Offline";
            statusBadge.classList.replace("bg-secondary", "bg-danger");
            return console.error(err.toString());
        });

        sendButton.addEventListener("click", function (event) {
            const message = messageInput.value.trim();
            if (!message) return;
            
            connection.invoke("SendMessage", "general", message).catch(function (err) {
                return console.error(err.toString());
            });
            
            messageInput.value = "";
            event.preventDefault();
        });

        messageInput.addEventListener("keypress", function (event) {
            if (event.key === "Enter") {
                sendButton.click();
            }
        });
    </script>
}
